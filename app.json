{
  "expo": {
    "name": "GymTracker",
    "slug": "gym-tracker",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D11",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gymtracker.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir o acesso às fotos para registar a tua evolução corporal.",
          "cameraPermission": "Permitir o acesso à câmara para tirar fotos de evolução corporal."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9460f179-d1b6-402e-994e-bbffbbe765b0"
      }
    }
  }
}
